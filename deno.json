{
	"name": "@mary/rar",
	"version": "0.1.0",
	"license": "0BSD",
	"exports": {
		".": "./lib/mod.ts",
		"./deno": "./lib/reader/deno.ts",
		"./node": "./lib/reader/node.ts"
	},
	"tasks": {
		"test": "deno test --allow-read"
	},
	"exclude": [".research/", "tests/fixtures/"],
