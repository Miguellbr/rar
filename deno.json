		"useTabs": true,
		"indentWidth": 2,
		"lineWidth": 110,
		"semiColons": true,
		"singleQuote": true
	},
	"publish": {
		"include": ["lib/", "LICENSE", "README.md", "deno.json"]
	},
	"imports": {
		"@mary/ds-queue": "jsr:@mary/ds-queue@^0.1.3",
		"@mary/mutex": "jsr:@mary/mutex@^0.1.0"
	}
}
